NPCTitles: {
	Guide: {
		Title: O GUIA
		Subtitle: Sabe tudo… menos como sobreviver.|Dicas grátis, mortes inclusas.|Seu primeiro amigo. Sua primeira perda.|Um manual ambulante com vida útil curta.|Sempre pronto pra ajudar. Nunca pra fugir.
	}

	Merchant: {
		Title: O MERCADOR
		Subtitle: Dinheiro compra felicidade, sim.|Se ele não vende, não existe.|Negócios primeiro, moral depois.|Aceita moedas. Sem desculpas.|Sua carteira treme.
	}

	Nurse: {
		Title: A ENFERMEIRA
		Subtitle: Curar é fácil. Cobrar é mais.|Cura instantânea, conta imediata.|A vida não é de graça, querido.|Menos dor, mais dívidas.|Te salva primeiro. Te quebra depois.
	}

	Demolitionist: {
		Title: O DEMOLIDOR
		Subtitle: Resolve tudo… com explosões.|Mais bombas, menos perguntas.|Sorria antes da detonação.|Especialista em dano colateral.|Se explode, funciona.
	}

	DyeTrader: {
		Title: O TINTUREIRO
		Subtitle: Estilo também se farma.|Cor hoje, combinações duvidosas amanhã.|Moda é sofrimento.|Tingir é arte. Às vezes.|Nunca combina, sempre vende.
	}

	Dryad: {
		Title: A DRÍADE
		Subtitle: A natureza está te julgando.|Menos corrupção, mais bronca.|Fala com plantas. Te ignora.|Eco-friendly e passivo-agressiva.|Ama a selva. Tolera o jogador.
	}

	ArmsDealer: {
		Title: O MERCADOR DE ARMAS
		Subtitle: Paz nunca foi uma opção.|Armas legalmente… questionáveis.|Atira primeiro, pergunta depois.|Munição pra qualquer problema.|Sorriso de vilão de filme.
	}

	Stylist: {
		Title: A ESTILISTA
		Subtitle: Cortes dramáticos pra vidas perigosas.|Esse cabelo não sobrevive à lua.|Beleza antes do apocalipse.|Coragem começa no corte.|Resultado não garantido.
	}

	Painter: {
		Title: O PINTOR
		Subtitle: Vê o mundo em cores estranhas.|Arte incompreendida, preços inflados.|Pinta sonhos… e paredes.|Inspirado, mas perdido.|Gênio criativo, zero contexto.
	}

	Angler: {
		Title: O PESCADOR
		Subtitle: Prodígio da chatice.|Mais missões, menos gratidão.|Nunca satisfeito.|Peixes raros, atitude péssima.|O verdadeiro chefe final.
	}

	GoblinTinkerer: {
		Title: O GOBLIN INVENTOR
		Subtitle: Reforja hoje, chora amanhã.|RNG faz parte da diversão.|Quebrar também é melhorar.|Confia em mim. Não devia.|Seu acessório agora é… diferente.
	}

	WitchDoctor: {
		Title: O MÉDICO FEITICEIRO
		Subtitle: Medicina alternativa, resultados duvidosos.|A selva aprova.|Veneno, vodu e estilo.|Não pergunte o que é.|Não cura — potencializa.
	}

	Clothier: {
		Title: O ALFAIATE
		Subtitle: Elegante, amaldiçoado e bem vestido.|A moda nunca morre. Você sim.|Roupas com passado sombrio.|Costura com trauma incluso.|Assombrado pelo passado.
	}

	Mechanic: {
		Title: A MECÂNICA
		Subtitle: Fios > pessoas.|Não funcionou? Coloca mais alavancas.|Ama máquinas. Odeia explicar.|Armadilhas que funcionam mesmo.|Engenharia com atitude.
	}

	PartyGirl: {
		Title: A GAROTA DA FESTA
		Subtitle: Confete antes da lógica.|Tudo fica melhor com balões.|Festa até no apocalipse.|Nunca se cansa. Nunca.|Nível de perigo: diversão.
	}

	DD2Bartender: {
		Title: O TAVERNEIRO
		Subtitle: Histórias longas, cervejas curtas.|Servindo Etheria desde sempre.|Um gole antes de morrer.|Missões com ressaca.|O único sóbrio é o jogador.
	}

	Golfer: {
		Title: O GOLFISTA
		Subtitle: Fugiu do deserto pelo golfe.|Tudo é um buraco em potencial.|Bate primeiro, mira depois.|Paciência opcional.|O green é sagrado.
	}

	BestiaryGirl: {
		Title: A ZOOLÓGA
		Subtitle: Amor excessivo por animais.|Quer tocar em tudo.|Pesquisa bem próxima.|Entusiasmo demais.|Ciência com abraços.
	}

	Wizard: {
		Title: O MAGO
		Subtitle: Sábio, poderoso e meio maluco.|Magia primeiro, bom senso depois.|Conhecimento arcano sem filtro.|A bola de cristal não mente.|Feitiços e ego.
	}

	TaxCollector: {
		Title: O COBRADOR DE IMPOSTOS
		Subtitle: O inferno cobra juros.|Nem a morte o parou.|Impostos são eternos.|Sem negociação.|O NPC mais temido.
	}

	Truffle: {
		Title: O TRUFA
		Subtitle: Um cogumelo com personalidade.|Chill demais pra esse mundo.|Viva, ria, esporos.|Não é comida.|Vibe fúngica pura.
	}

	Pirate: {
		Title: O PIRATA
		Subtitle: Rum, canhões e gritaria.|Arrr com orgulho.|Tesouro ou nada.|Nunca paga impostos.|O mar chama.
	}

	Steampunker: {
		Title: A STEAMPUNKER
		Subtitle: Ciência com estilo.|Odeia tecnologia velha.|Engrenagens acima da magia.|O futuro é agora.|Vapor e atitude.
	}

	Cyborg: {
		Title: O CYBORG
		Subtitle: Otimizado para destruição.|Menos humano, mais armas.|Cálculos balísticos constantes.|Não sente… mas atira.|Tecnologia hostil.
	}

	SantaClaus: {
		Title: PAPAI NOEL
		Subtitle: Presentes com condições.|Ele está de olho.|A lista não mente.|Natal armado.|Ho ho… cuidado.
	}

	Princess: {
		Title: A PRINCESA
		Subtitle: Elegância inexplicável.|Não faz nada. Perfeitamente.|A mais feliz daqui.|Vivendo sua melhor vida.|Vibes reais.
	}

	TravellingMerchant: {
		Title: MERCADOR VIAJANTE
		Subtitle: Aqui hoje, gone amanhã.|Inventário imprevisível.|Compre rápido.|Nunca explica nada.|Vai embora sem avisar.
	}

	SkeletonMerchant: {
		Title: MERCADOR ESQUELETO
		Subtitle: Negócios noturnos.|Ossos e aleatoriedade.|Preços mortais.|Sem pele em jogo.|Literalmente sem vergonha.
	}

	// --- CALAMITY MOD ---
	SeaKing: {
		Title: O Rei do Mar
		Subtitle: Governante do Mar Submerso.|Sente o cheiro de sal?|Amidias busca refúgio.
	}

	Bandit: {
		Title: O Bandido
		Subtitle: Escondam suas moedas!|Chegada furtiva.|Melhor que um Goblin.
	}

	DrunkPrincess: {
		Title: A Princesa Bêbada
		Subtitle: Isso é vodka?|Festa duro!|Não conte ao pai dela.
	}

	Archmage: {
		Title: O Arquimago
		Subtitle: Permafrost está livre.|O inverno está chegando.|Mestre do Cryogen.
	}

	Witch: {
		Title: A Bruxa de Enxofre
		Subtitle: Buscando redenção.|Não é mais um chefe.|Não a deixe irritada.
	}

	// --- ALCHEMIST NPC LITE ---
	Alchemist: {
		Title: O Alquimista
		Subtitle: Poções aos montes.|Viva a química!|Vida melhor através da ciência.
	}

	Brewer: {
		Title: A Cervejeira
		Subtitle: Saúde!|Essa é por conta da casa.|Beba com responsabilidade.
	}

	Jeweler: {
		Title: O Joalheiro
		Subtitle: Gemas brilhantes.|Bling bling.|Acessórios à venda.
	}

	Architect: {
		Title: O Arquiteto
		Subtitle: Construção facilitada.|Blocos pra todo lado!|Podemos consertar? Sim, nós podemos!
	}

	Operator: {
		Title: A Operadora
		Subtitle: Loja de espólios de chefes.|Devoradora de Materiais.|Sistemas online.
	}

	Musician: {
		Title: O Músico
		Subtitle: Solta o som.|Vendedor de caixas de música.|Sinfonia da noite.
	}

	Tinkerer: {
		Title: O Inventor
		Subtitle: Expert em acessórios.|Eu posso consertar isso.|Sem devoluções.
	}

	// --- THORIUM MOD ---
	DesertTraveler: {
		Title: O Acólito do Deserto
		Subtitle: Sobrevivente das areias.|Herói do deserto.|Poder do cacto!
	}

	Cook: {
		Title: O Cozinheiro
		Subtitle: O jantar está servido.|Refeições gourmet.|Não brinque com a comida.
	}

	Cobbler: {
		Title: O Sapateiro
		Subtitle: Sapatos chiques.|Correndo na velocidade do som.|Olhe por onde pisa.
	}

	Diver: {
		Title: O Mergulhador
		Subtitle: No fundo do mar.|Tanques de oxigênio inclusos.|Segredos do azul profundo.
	}

	Blacksmith: {
		Title: O Ferreiro
		Subtitle: Hora do martelo.|A forja está quente.|Aço e fogo.
	}

	ConfusedZombie: {
		Title: O Zumbi Confuso
		Subtitle: Cérebros? Não, obrigado.|Morto-vivo amigável.|Ele parece perdido.
	}

	WeaponMaster: {
		Title: O Mestre de Armas
		Subtitle: Afie sua lâmina.|Mestre das armas.|Treino de combate.
	}

	Spiritualist: {
		Title: A Espiritualista
		Subtitle: Espíritos nos cercam.|Vida e morte.|Alma pacífica.
	}

	// --- MAGIC STORAGE ---
	Automaton: {
		Title: O Autômato
		Subtitle: Armazenamento simplificado.|Inventário digital.|Chega de baús!
	}

	// --- FARGO'S MUTANT MOD ---
	Mutant: {
		Title: O Mutante
		Subtitle: Destruidor de mundos.|Quer sofrer?|Hora do Boss Rush!
	}

	Abominationn: {
		Title: A Abominação
		Subtitle: Iniciador de eventos.|Caos a caminho.|Prepare-se para problemas.
	}

	Deviantt: {
		Title: A Deviantt
		Subtitle: Ajuda com criaturas raras.|Rosa e perigosa.|Um guia útil?
	}

	LumberJack: {
		Title: O Lenhador
		Subtitle: Madeira de sobra.|Cortador de árvores.|Expert em desmatamento.
	}

	Default.Subtitle: Um novo aliado se junta à causa.
}

