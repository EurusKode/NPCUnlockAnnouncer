NPCTitles: {
	Guide: {
		Title: DER GUIDE
		Subtitle: Weiß alles… außer wie man überlebt.|Gratis Tipps, Tode inklusive.|Dein erster Freund. Dein erster Verlust.|Ein laufendes Handbuch mit kurzer Lebenserwartung.|Immer hilfsbereit. Nie fluchtbereit.
	}

	Merchant: {
		Title: DER HÄNDLER
		Subtitle: Geld kauft Glück. Punkt.|Wenn er es nicht verkauft, existiert es nicht.|Geschäfte zuerst, Moral später.|Akzeptiert Münzen. Keine Ausreden.|Dein Geldbeutel zittert.
	}

	Nurse: {
		Title: DIE KRANKENSCHWESTER
		Subtitle: Heilen ist einfach. Abkassieren auch.|Sofortige Heilung, sofortige Rechnung.|Leben ist nicht kostenlos, Schatz.|Weniger Schmerz, mehr Schulden.|Erst rettet sie dich. Dann ruiniert sie dich.
	}

	Demolitionist: {
		Title: DER SPRENGMEISTER
		Subtitle: Löst alles… mit Explosionen.|Mehr Bomben, weniger Fragen.|Lächeln vor der Detonation.|Experte für Kollateralschäden.|Wenn es knallt, funktioniert es.
	}

	DyeTrader: {
		Title: DER FÄRBER
		Subtitle: Stil muss gefarmt werden.|Heute Farbe, morgen fragwürdige Kombos.|Mode ist Leiden.|Färben ist Kunst. Manchmal.|Passt nie zusammen, verkauft immer.
	}

	Dryad: {
		Title: DIE DRYADE
		Subtitle: Die Natur verurteilt dich.|Weniger Verderbnis, mehr Gemecker.|Spricht mit Pflanzen. Ignoriert dich.|Öko und passiv-aggressiv.|Liebt den Dschungel. Duldet den Spieler.
	}

	ArmsDealer: {
		Title: DER WAFFENHÄNDLER
		Subtitle: Frieden war nie eine Option.|Rechtlich… fragwürdige Waffen.|Erst schießen, dann fragen.|Munition für jedes Problem.|Lächelt wie ein Filmschurke.
	}

	Stylist: {
		Title: DIE STYLISTIN
		Subtitle: Dramatische Schnitte für gefährliche Leben.|Diese Frisur überlebt den Mond nicht.|Schönheit vor Apokalypse.|Mut beginnt mit Pony.|Verwandlung nicht garantiert.
	}

	Painter: {
		Title: DER MALER
		Subtitle: Sieht die Welt in seltsamen Farben.|Missverstandene Kunst, überteuerte Preise.|Malt Träume… und Wände.|Inspiriert, aber verloren.|Kreatives Genie, null Kontext.
	}

	Angler: {
		Title: DER ANGLER
		Subtitle: Wunderkind der Nervigkeit.|Mehr Quests, weniger Dank.|Nie zufrieden.|Seltene Fische, schlechte Laune.|Der wahre Endboss.
	}

	GoblinTinkerer: {
		Title: DER GOBLIN-TÜFTLER
		Subtitle: Heute reforgen, morgen weinen.|Zufall gehört dazu.|Kaputtmachen zählt als Verbesserung.|Vertrau mir. Solltest du nicht.|Dein Accessoire ist jetzt… anders.
	}

	WitchDoctor: {
		Title: DER HEXENDOKTOR
		Subtitle: Alternative Medizin, fragwürdige Ergebnisse.|Der Dschungel nickt.|Gift, Voodoo und Stil.|Frag nicht, was es ist.|Nicht heilen—verstärken.
	}

	Clothier: {
		Title: DER SCHNEIDER
		Subtitle: Elegant, verflucht und gut gekleidet.|Mode stirbt nie. Du schon.|Kleidung mit dunkler Vergangenheit.|Schneiderei mit Trauma.|Von der Vergangenheit verfolgt.
	}

	Mechanic: {
		Title: DIE MECHANIKERIN
		Subtitle: Kabel > Menschen.|Wenn es nicht klappt, mehr Hebel.|Liebt Maschinen. Hasst Erklärungen.|Fallen, die wirklich funktionieren.|Ingenieurskunst mit Attitüde.
	}

	PartyGirl: {
		Title: DAS PARTY-GIRL
		Subtitle: Konfetti vor Logik.|Alles ist besser mit Ballons.|Party selbst in der Apokalypse.|Wird nie müde. Niemals.|Gefahrenstufe: Spaß.
	}

	DD2Bartender: {
		Title: DER TAVERNENWIRT
		Subtitle: Lange Geschichten, kurze Biere.|Bedient Etheria seit Ewigkeiten.|Ein Drink vor dem Tod.|Quests mit Kater.|Der Spieler ist der einzig Nüchterne.
	}

	Golfer: {
		Title: DER GOLFSPIELER
		Subtitle: Floh aus der Wüste fürs Golf.|Alles ist ein potenzielles Loch.|Erst schlagen, dann zielen.|Geduld optional.|Das Grün ist heilig.
	}

	BestiaryGirl: {
		Title: DIE ZOOLOGIN
		Subtitle: Übermäßige Tierliebe.|Will alles streicheln.|Sehr praktische Forschung.|Viel zu begeistert.|Wissenschaft mit Umarmungen.
	}

	Wizard: {
		Title: DER ZAUBERER
		Subtitle: Weise, mächtig und leicht verrückt.|Magie zuerst, Verstand später.|Arkane Weisheit ohne Filter.|Die Kristallkugel lügt nicht.|Zauber und Ego.
	}

	TaxCollector: {
		Title: DER STEUEREINTREIBER
		Subtitle: Die Hölle verlangt Zinsen.|Der Tod hielt ihn nicht auf.|Steuern sind ewig.|Keine Verhandlungen.|Der meistgefürchtete NPC.
	}

	Truffle: {
		Title: DER TRÜFFEL
		Subtitle: Ein Pilz mit Persönlichkeit.|Zu entspannt für diese Welt.|Lebe, lache, Sporen.|Nicht essbar.|Reine Pilz-Vibes.
	}

	Pirate: {
		Title: DER PIRAT
		Subtitle: Rum, Kanonen und Gebrüll.|Arrr mit Stolz.|Schatz oder nichts.|Zahlt nie Steuern.|Das Meer ruft.
	}

	Steampunker: {
		Title: DIE STEAMPUNKERIN
		Subtitle: Wissenschaft mit Stil.|Hasst alte Technik.|Zahnräder statt Magie.|Die Zukunft ist jetzt.|Dampf und Attitüde.
	}

	Cyborg: {
		Title: DER CYBORG
		Subtitle: Optimiert für Zerstörung.|Weniger Mensch, mehr Waffen.|Ständige ballistische Berechnung.|Fühlt nichts… schießt aber.|Feindliche Technologie.
	}

	SantaClaus: {
		Title: SANTA CLAUS
		Subtitle: Geschenke mit Bedingungen.|Beobachtet alles.|Die Liste lügt nicht.|Bewaffnete Weihnachten.|Ho ho… Vorsicht.
	}

	Princess: {
		Title: DIE PRINZESSIN
		Subtitle: Unerklärliche Eleganz.|Tut nichts. Perfekt.|Die Glücklichste hier.|Lebt ihr bestes Leben.|Royale Vibes.
	}

	TravellingMerchant: {
		Title: WANDERHÄNDLER
		Subtitle: Heute hier, morgen weg.|Unberechenbares Inventar.|Schnell kaufen.|Erklärt nie etwas.|Verschwindet ohne Warnung.
	}

	SkeletonMerchant: {
		Title: SKELETT-HÄNDLER
		Subtitle: Geschäfte bei Nacht.|Knochen und Zufall.|Tödliche Preise.|Kein Fell im Spiel.|Wörtlich schamlos.
	}

	// --- CALAMITY MOD ---
	SeaKing: {
		Title: Der Meereskönig
		Subtitle: Herrscher der Versunkenen See.|Riechst du das Salz?|Amidias sucht Zuflucht.
	}

	Bandit: {
		Title: Der Bandit
		Subtitle: Versteckt eure Münzen!|Ein heimlicher Zugang.|Besser als ein Kobold.
	}

	DrunkPrincess: {
		Title: Die Betrunkene Prinzessin
		Subtitle: Ist das Wodka?|Feiern bis zum Umfallen!|Sag es nicht ihrem Vater.
	}

	Archmage: {
		Title: Der Erzmagier
		Subtitle: Permafrost ist frei.|Der Winter naht.|Meister von Cryogen.
	}

	Witch: {
		Title: Die Schwefelhexe
		Subtitle: Sucht nach Erlösung.|Kein Boss mehr.|Mach sie nicht wütend.
	}

	// --- ALCHEMIST NPC LITE ---
	Alchemist: {
		Title: Der Alchemist
		Subtitle: Tränke ohne Ende.|Chemie an die Macht!|Besser leben durch Wissenschaft.
	}

	Brewer: {
		Title: Die Brauerin
		Subtitle: Prost!|Das geht aufs Haus.|Trink verantwortungsbewusst.
	}

	Jeweler: {
		Title: Der Juwelier
		Subtitle: Glänzende Edelsteine.|Bling Bling.|Accessoires zu verkaufen.
	}

	Architect: {
		Title: Der Architekt
		Subtitle: Bauen leicht gemacht.|Blöcke in Hülle und Fülle!|Können wir das schaffen? Jo, wir schaffen das!
	}

	Operator: {
		Title: Die Operatorin
		Subtitle: Boss-Beute-Shop.|Verschlingerin von Materialien.|Systeme online.
	}

	Musician: {
		Title: Der Musiker
		Subtitle: Lass den Beat droppen.|Musikbox-Verkäufer.|Sinfonie der Nacht.
	}

	Tinkerer: {
		Title: Der Tüftler
		Subtitle: Zubehör-Experte.|Ich kann das reparieren.|Keine Rückerstattung.
	}

	// --- THORIUM MOD ---
	DesertTraveler: {
		Title: Der Wüstenakolyth
		Subtitle: Überlebender des Sandes.|Held der Wüste.|Kaktus-Power!
	}

	Cook: {
		Title: Der Koch
		Subtitle: Das Essen ist serviert.|Gourmet-Mahlzeiten.|Spiel nicht mit dem Essen.
	}

	Cobbler: {
		Title: Der Schuster
		Subtitle: Schicke Schuhe.|Laufen mit Schallgeschwindigkeit.|Pass auf, wo du hintrittst.
	}

	Diver: {
		Title: Der Taucher
		Subtitle: Unter dem Meer.|Sauerstoffflaschen inklusive.|Geheimnisse der Tiefe.
	}

	Blacksmith: {
		Title: Der Schmied
		Subtitle: Zeit für den Hammer.|Die Esse ist heiß.|Stahl und Feuer.
	}

	ConfusedZombie: {
		Title: Der Verwirrte Zombie
		Subtitle: Gehirne? Nein, danke.|Freundlicher Untoter.|Er scheint sich verlaufen zu haben.
	}

	WeaponMaster: {
		Title: Der Waffenmeister
		Subtitle: Schärfe deine Klinge.|Meister der Waffen.|Kampftraining.
	}

	Spiritualist: {
		Title: Die Spiritualistin
		Subtitle: Geister umgeben uns.|Leben und Tod.|Friedliche Seele.
	}

	// --- MAGIC STORAGE ---
	Automaton: {
		Title: Der Automat
		Subtitle: Lagerung vereinfacht.|Digitales Inventar.|Keine Truhen mehr!
	}

	// --- FARGO'S MUTANT MOD ---
	Mutant: {
		Title: Der Mutant
		Subtitle: Weltenbrecher.|Willst du leiden?|Zeit für den Boss-Rush!
	}

	Abominationn: {
		Title: Das Scheusaal
		Subtitle: Event-Starter.|Chaos im Anmarsch.|Bereite dich auf Ärger vor.
	}

	Deviantt: {
		Title: Die Abweichhlerin
		Subtitle: Hilfe bei seltenen Kreaturen.|Pink und gefährlich.|Ein hilfreicher Guide?
	}

	LumberJack: {
		Title: Der Holzfäller
		Subtitle: Holz ohne Ende.|Baumhacker.|Experte für Abholzung.
	}

	Default.Subtitle: Ein neuer Verbündeter schließt sich an.
}

