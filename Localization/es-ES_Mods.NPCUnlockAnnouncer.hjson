NPCTitles: {
	Guide: {
		Title: EL GUÍA
		Subtitle: Sabe todo… excepto cómo sobrevivir.|Consejos gratis, muertes incluidas.|Tu primer amigo. Tu primera pérdida.|Manual viviente con esperanza limitada.|Siempre listo para ayudar. Nunca para huir.
	}

	Merchant: {
		Title: EL MERCADER
		Subtitle: El dinero sí compra la felicidad.|Si no lo vende él, no existe.|Negocios primero, moral después.|Acepta monedas. No acepta excusas.|Tu billetera tiembla al verlo.
	}

	Nurse: {
		Title: LA ENFERMERA
		Subtitle: Curarte es fácil. Cobrarte también.|Sanación exprés, factura inmediata.|La vida no es gratis, cariño.|Menos dolor, más deudas.|Primero te salva. Luego te arruina.
	}

	Demolitionist: {
		Title: EL DEMOLEDOR
		Subtitle: Soluciona todo… con explosiones.|Más bombas, menos preguntas.|Sonríe antes de detonar.|Especialista en daños colaterales.|Si hace boom, funciona.
	}

	DyeTrader: {
		Title: EL VENDEDOR DE TINTES
		Subtitle: El estilo también se farmea.|Color hoy, combinación dudosa mañana.|La moda es sufrimiento.|Teñir es un arte. A veces.|Nunca combina, pero siempre vende.
	}

	Dryad: {
		Title: LA DRÍADA
		Subtitle: La naturaleza te está juzgando.|Menos corrupción, más regaños.|Habla con plantas. Te ignora a ti.|Eco-friendly y muy pasivo-agresiva.|Ama la selva. Tolera al jugador.
	}

	ArmsDealer: {
		Title: EL VENDEDOR DE ARMAS
		Subtitle: La paz nunca fue una opción.|Armas legales… probablemente.|Dispara primero, pregunta después.|Munición para todo problema.|Sonríe como villano de película.
	}

	Stylist: {
		Title: LA ESTILISTA
		Subtitle: Cortes dramáticos para vidas peligrosas.|Tu look no sobrevivirá a la luna.|Belleza antes del apocalipsis.|Peinarse también es valentía.|Transformaciones sin garantía.
	}

	Painter: {
		Title: EL PINTOR
		Subtitle: Ve el mundo en colores raros.|Arte incomprendido, precios inflados.|Pinta sueños… y paredes.|Inspirado, pero perdido.|Genio creativo, cero contexto.
	}

	Angler: {
		Title: EL PESCADOR
		Subtitle: Niño prodigio del fastidio.|Más misiones, menos gratitud.|Nunca está satisfecho.|Pesca rara, actitud peor.|El verdadero jefe final.
	}

	GoblinTinkerer: {
		Title: EL DUENDE CHAPUCERO
		Subtitle: Reforja hoy, llora mañana.|El azar es parte del encanto.|Romper también cuenta como mejorar.|Confía en mí. No deberías.|Tu accesorio ya no es el mismo.
	}

	WitchDoctor: {
		Title: EL MÉDICO BRUJO
		Subtitle: Medicina alternativa, resultados dudosos.|La selva aprueba esto.|Veneno, vudú y estilo.|No preguntes qué es.|Curar no, potenciar.
	}

	Clothier: {
		Title: EL SASTRE
		Subtitle: Elegante, maldito y bien vestido.|La moda nunca muere. Tú sí.|Trajes con historia oscura.|Costura con trauma incluido.|El pasado lo sigue.
	}

	Mechanic: {
		Title: LA MECÁNICA
		Subtitle: Cables > personas.|Si falla, agrega más palancas.|Ama los mecanismos. Odia explicarlos.|Trampas que sí funcionan.|Ingeniería con actitud.
	}

	PartyGirl: {
		Title: LA CHICA FIESTERA
		Subtitle: Confeti antes que lógica.|Todo es mejor con globos.|Fiesta incluso en el apocalipsis.|Nunca se cansa. Nunca.|Peligro nivel: divertido.
	}

	DD2Bartender: {
		Title: EL TABERNERO
		Subtitle: Historias largas, cerveza corta.|Sirviendo Etheria desde siempre.|Un trago antes de morir.|Misiones con resaca.|El único sobrio es el jugador.
	}

	Golfer: {
		Title: EL GOLFISTA
		Subtitle: Huyó del desierto por el golf.|Todo es un hoyo potencial.|Golpea primero, apunta después.|La paciencia es opcional.|El green es sagrado.
	}

	BestiaryGirl: {
		Title: LA ZOÓLOGA
		Subtitle: Amor animal en exceso.|Quiere tocarlos todos.|Investigación muy de cerca.|Demasiado entusiasmo.|Ciencia con abrazos.
	}

	Wizard: {
		Title: EL MAGO
		Subtitle: Sabio, poderoso y algo loco.|Magia primero, sentido común después.|Conocimiento arcano sin filtro.|La bola no miente.|Hechizos y egos.
	}

	TaxCollector: {
		Title: EL RECAUDADOR DE IMPUESTOS
		Subtitle: El infierno cobra intereses.|La muerte no lo detuvo.|Impuestos eternos.|No negocia.|El más temido.
	}

	Truffle: {
		Title: TRUFA
		Subtitle: Hongo con personalidad.|Demasiado chill para este mundo.|Vive, ríe, esporas.|No es comida.|Vibra fungi.
	}

	Pirate: {
		Title: EL PIRATA
		Subtitle: Ron, cañones y gritos.|Arrr con orgullo.|Tesoro o nada.|Nunca paga impuestos.|El mar lo llama.
	}

	Steampunker: {
		Title: LA STEAMPUNKER
		Subtitle: Ciencia con estilo.|Odia lo antiguo.|Engranajes sobre magia.|El futuro es ahora.|Vapor y actitud.
	}

	Cyborg: {
		Title: EL CYBORG
		Subtitle: Optimizado para destruir.|Menos humano, más armas.|Cálculo balístico constante.|No siente… pero dispara.|Tecnología hostil.
	}

	SantaClaus: {
		Title: SANTA CLAUS
		Subtitle: Regalos con condiciones.|Observando todo.|La lista no miente.|Navidad armada.|Ho ho… cuidado.
	}

	Princess: {
		Title: LA PRINCESA
		Subtitle: Elegancia inexplicable.|No hace nada. Perfectamente.|La más feliz aquí.|Vive su mejor vida.|Royal vibes.
	}

	TravellingMerchant: {
		Title: MERCADER AMBULANTE
		Subtitle: Hoy sí, mañana quién sabe.|Inventario impredecible.|Compra rápido.|Nunca explica nada.|Se va sin avisar.
	}

	SkeletonMerchant: {
		Title: MERCADER ESQUELETO
		Subtitle: Negocios nocturnos.|Huesos y azar.|Precios mortales.|No tiene piel en el juego.|Literalmente sin escrúpulos.
	}

	// --- CALAMITY MOD ---
	SeaKing: {
		Title: El Rey del Mar
		Subtitle: Gobernante del Mar Hundido.|¿Hueles a sal?|Amidias busca refugio.
	}

	Bandit: {
		Title: El Bandido
		Subtitle: ¡Esconde tus monedas!|Llegada sigilosa.|Mejor que el Duende Chapucero.
	}

	DrunkPrincess: {
		Title: La Princesa Ebria
		Subtitle: ¿Eso es vodka?|¡Fiesta dura!|No se lo digas a su padre.
	}

	Archmage: {
		Title: El Archimago
		Subtitle: Permafrost es libre.|Se acerca el invierno.|Maestro de Cryogen.
	}

	Witch: {
		Title: La Bruja de Azufre
		Subtitle: Buscando redención.|Ya no es un jefe.|No la hagas enojar.
	}

	// --- ALCHEMIST NPC LITE ---
	Alchemist: {
		Title: El Alquimista
		Subtitle: Pociones a montones.|¡Viva la química!|Vida mejor gracias a la ciencia.
	}

	Brewer: {
		Title: La Cervecera
		Subtitle: ¡Salud!|Esta ronda va por la casa.|Bebe con responsabilidad.
	}

	Jeweler: {
		Title: El Joyero
		Subtitle: Gemas brillantes dentro.|Bling bling.|Accesorios a la venta.
	}

	Architect: {
		Title: El Arquitecto
		Subtitle: Construcción fácil.|¡Bloques por doquier!|¿Podemos hacerlo? ¡Sí podemos!
	}

	Operator: {
		Title: La Operadora
		Subtitle: Tienda de botín de jefes.|Devoradora de Materiales.|Sistemas en línea.
	}

	Musician: {
		Title: El Músico
		Subtitle: Sube el ritmo.|Vendedor de cajas de música.|Sinfonía de la noche.
	}

	Tinkerer: {
		Title: El Artesano
		Subtitle: Experto en accesorios.|Yo puedo arreglar eso.|Sin devoluciones.
	}

	// --- THORIUM MOD ---
	DesertTraveler: {
		Title: El Acólito del Desierto
		Subtitle: Sobreviviente de las arenas.|Héroe del desierto.|¡Poder de cactus!
	}

	Cook: {
		Title: El Cocinero
		Subtitle: La cena está servida.|Comidas gourmet.|No juegues con tu comida.
	}

	Cobbler: {
		Title: El Zapatero
		Subtitle: Zapatos elegantes.|Corriendo a la velocidad del sonido.|Cuidado donde pisas.
	}

	Diver: {
		Title: El Buzo
		Subtitle: Bajo el mar.|Tanques de oxígeno incluidos.|Secretos del azul profundo.
	}

	Blacksmith: {
		Title: El Herrero
		Subtitle: Hora del martillo.|La forja está caliente.|Acero y fuego.
	}

	ConfusedZombie: {
		Title: El Zombi Confundido
		Subtitle: ¿Cerebros? No, gracias.|No-muerto amigable.|Parece perdido.
	}

	WeaponMaster: {
		Title: El Maestro de Armas
		Subtitle: Afila tu hoja.|Maestro de las armas.|Entrenamiento de combate.
	}

	Spiritualist: {
		Title: La Espiritista
		Subtitle: Los espíritus nos rodean.|Vida y muerte.|Alma pacífica.
	}

	// --- MAGIC STORAGE ---
	Automaton: {
		Title: El Autómata
		Subtitle: Almacenamiento simplificado.|Inventario digital.|¡No más cofres!
	}

	// --- FARGO'S MUTANT MOD ---
	Mutant: {
		Title: El Mutante
		Subtitle: Destructor de mundos.|¿Quieres sufrir?|¡Hora del Boss Rush!
	}

	Abominationn: {
		Title: El Abominación
		Subtitle: Iniciador de eventos.|Caos entrante.|Prepárate para los problemas.
	}

	Deviantt: {
		Title: La Deviantt
		Subtitle: Ayuda con criaturas raras.|Rosa y peligrosa.|¿Una guía útil?
	}

	LumberJack: {
		Title: El Leñador
		Subtitle: Madera de sobra.|Talador de árboles.|Experto en deforestación.
	}

	Default.Subtitle: Un nuevo aliado se une a la causa.
}

Configs: {
	AnnouncerConfig: {
		DisplayName: Opciones del Anunciador

		Headers: {
			GeneralSettings: Ajustes Generales
			CustomMessages: Mensajes Personalizados de NPC
		}

		Style: {
			Label: Estilo del Cuadro de Notificación
			Tooltip: Classic: Cuadro tradicional negro y dorado. Modern: Cuadro neon glassmorphism animado. Corruption: Tema Corrupción. Crimson: Tema Carmesí. Wood: Tema Madera. Jungle: Tema Selva.
		}

		Sound: {
			Label: Sonido de Anuncio
			Tooltip: El sonido que se reproduce cuando aparece la notificación de un NPC desbloqueado.
		}

		SoundVolume: {
			Label: Volumen del Sonido
			Tooltip: Ajusta el volumen del sonido de anuncio.
		}

		DurationSeconds: {
			Label: Duración de Notificación (segundos)
			Tooltip: Tiempo que permanece visible la notificación en pantalla.
		}

		CustomNPCMessages: {
			Label: Personalizar Mensajes de NPC
			Tooltip: Sobrescribe el título y subtítulo de cualquier NPC del pueblo.
		}
	}

	NPCMessageConfig: {
		NPC: {
			Label: NPC
			Tooltip: El NPC a personalizar.
		}

		Title: {
			Label: Título Personalizado
			Tooltip: Título personalizado para este NPC. Déjalo en blanco para usar la traducción o el valor por defecto.
		}

		Subtitle: {
			Label: Subtítulo Personalizado
			Tooltip: Subtítulo(s) personalizado(s) para este NPC. Puedes separar varios subtítulos con '|' para que se elija uno al azar. Déjalo en blanco para usar la traducción o el valor por defecto.
		}

		// Tooltip: ""
	}

